{
  "name": "memorial-foundation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "verify": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test",
    "e2e": "playwright test",
    "secrets": "secretlint '**/*' && node scripts/check-private-identifiers.mjs",
    "worker": "tsx src/features/foundation/worker.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "2.2.0",
    "@dha-team/arbundles": "1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@vercel/blob": "2.9.0",
    "archiver": "8.0.0",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.1",
    "viem": "2.58.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/postcss": "4.3.5",
    "@types/archiver": "8.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-playwright": "2.12.2",
    "secretlint": "14.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "type": "module"
}
