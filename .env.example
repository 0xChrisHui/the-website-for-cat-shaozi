# 应用运行位置。仅本机显式 development，Vercel 由平台提供。
VERCEL_ENV=
# 本机及 Vercel 对应的稳定 origin，用于维护写操作的 Origin 验证。
APP_ORIGIN=
# Supabase Auth 公开 URL 和 anon key。本站与 Auth 项目分开校验。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 应用 / 工作器 / db-admin 的预期共用项目标识。
SUPABASE_PROJECT_REF=
# 对应环境维护者 UID。仅 Vercel 和本地测试。
MAINTAINER_UID=
# 网站使用事务池。工作器使用直连或会话池。都要求 TLS。
DATABASE_URL=
WORKER_DATABASE_URL=
EXPECTED_DATABASE_HOST=
DATABASE_CA_CERT_BASE64=
# 仅测试 Preview / 本机的随机票据签名密钥（至少 32 字节）。
SAMPLE_SESSION_SECRET=
# 仅测试 Preview：Grok 样板 origin、独立 Bearer 和发送者的 SHA-256。
TEST_CALLBACK_ORIGIN=
# 仅正式 Vercel。
PROD_CALLBACK_ORIGIN=
STAGE0_INTAKE_TOKEN=
GROK_SENDER_SHA256=
# 板块 1 的对应环境专用 Bearer。
GROK_INTAKE_TOKEN=
# 各环境自己的 private Blob store。只在服务端与工作器使用。
BLOB_STORE_HOST=
BLOB_READ_WRITE_TOKEN=
# 预览 / 正式各自配置的接收和读取上限。
MAIL_RETENTION_DAYS=
INTAKE_REQUESTS_PER_MINUTE=
INTAKE_MAX_ITEMS=
INTAKE_MAX_EVENT_BYTES=
INTAKE_MAX_STAGED_BYTES=
UPLOAD_GRANT_TTL_SECONDS=
PRIVATE_READ_TTL_SECONDS=
# Contabo 系统级服务：独立实例、原件根目录与告警通道。
WORKER_INSTANCE=
WORKER_FILE_ROOT=
WORKER_NOTIFY_ENDPOINT=
WORKER_NOTIFY_TOKEN=
DISK_WARN_PERCENT=
TURBO_WARN_CREDITS=
TURBO_BALANCE_URL=
# 仅测试工作器的沙箱配置 / 钱包文件引用与合成口令。
GROK_SANDBOX_URL=
TURBO_TEST_URL=
OP_SEPOLIA_RPC_URL=
ALCHEMY_OP_SEPOLIA_RPC_URL=
OP_SEPOLIA_EXPLORER_API_KEY=
TEST_WALLET_FILE=
TEST_DIARY_ARCHIVE_PASSPHRASE=
MAX_FEE_PER_GAS_WEI=
MAX_GAS_LIMIT=
MAX_OPERATION_COST_WEI=
# 仅正式受限签名服务。不得放在本机、CI、Preview 或测试配置。
OP_MAINNET_RPC_URL=
OP_MAINNET_EXPLORER_API_KEY=
MAINNET_WALLET_FILE=
DIARY_ARCHIVE_PASSPHRASE=
ALLOW_MAINNET=
TURBO_PRODUCTION_URL=
# 仅 GitHub db-admin / prod-db-admin。按环境填受限迁移连接。
SCHEMA_DATABASE_URL=
# 仅 GitHub db-admin 的独立体检步骤。
SUPABASE_ACCESS_TOKEN=
# 仅 GitHub 仓库级测试预览放行密钥。
VERCEL_AUTOMATION_BYPASS_SECRET=
# GitHub Actions Variables。
TEST_VERCEL_DEPLOYMENT_ENV=
TEST_VERCEL_PROJECT_ID=
TEST_VERCEL_PREVIEW_SUFFIX=
TEST_VERCEL_ACTOR_ID=
MAINTAINER_GITHUB_LOGIN=
PRODUCTION_ORIGIN=
TEST_VERCEL_PROJECT_SLUG=
REVIEWED_MIGRATION_SHA=
ENABLE_PRODUCTION_READONLY=
# D1 仅从手工探针进程注入，禁止 Vercel、工作树环境和 CI 使用。
TEST_MAINTAINER_EMAIL=
TEST_MAINTAINER_PASSWORD=
# 仅测试工作器发布计时器，配置在 test-deploy.env。
WORKER_REPOSITORY=
WORKER_GIT_DIR=
# 仅 D1 手工回读/删除探针，等于已核对的测试 Blob 主机。
CONFIRM_D1_TEST_BLOB=
